  "premises": {
    "prem_02efd5ab1c2f302d": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_02efd5ab1c2f302d",
      "premise_type": "empirical-citable",
      "termination_reason": "citation-shaped",
      "text": "The inflated spinach iron figure was reproduced in subsequent food composition tables, textbooks, and popular media rather than being corrected before wide circulation."
    },
    "prem_046c0211391752ee": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_046c0211391752ee",
      "premise_type": "empirical-citable",
      "termination_reason": "citation-shaped",
      "text": "The tenfold discrepancy in the published spinach iron figure originated from a decimal point being placed one position to the right of its correct location."
    },
    "prem_4c317d5e35daf5a7": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_4c317d5e35daf5a7",
      "premise_type": "empirical-citable",
      "termination_reason": "citation-shaped",
      "text": "Spinach is widely reputed in popular culture and nutrition writing to be an exceptionally rich dietary source of iron."
    },
    "prem_5ba5e7f4c7a48c94": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_5ba5e7f4c7a48c94",
      "premise_type": "empirical-citable",
      "termination_reason": "citation-shaped",
      "text": "Spinach's public reputation as an iron-rich food arose from the circulated inflated iron figure rather than from independent observation or promotion."
    },
    "prem_6d6efebf2000b58e": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_6d6efebf2000b58e",
      "premise_type": "empirical-citable",
      "termination_reason": "citation-shaped",
      "text": "Spinach's measured iron content, about 2 to 3 milligrams per 100 grams fresh weight, is comparable to that of many other leafy vegetables and not exceptional."
    },
    "prem_784bd425963d28c9": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_784bd425963d28c9",
      "premise_type": "empirical-citable",
      "termination_reason": "citation-shaped",
      "text": "A nineteenth-century published chemical analysis reported spinach's iron content as roughly ten times the value obtained by later analyses."
    }
  },
  "root_claim": {
