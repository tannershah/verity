      "premise_type": "empirical-citable",
      "termination_reason": null,
      "text": "The inflated iron figure for spinach was reproduced across textbooks, dietary guides, and popular media for decades after its original publication."
    },
    "prem_1d3a3e7e2988a6d2": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_1d3a3e7e2988a6d2",
      "premise_type": "background",
      "termination_reason": null,
      "text": "Spinach's popular reputation as an exceptionally iron-rich food emerged and spread during the period in which the inflated iron figure was in circulation."
    },
    "prem_6746388cbf3b37b5": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_6746388cbf3b37b5",
      "premise_type": "statistical",
      "termination_reason": null,
      "text": "A reported value that is exactly ten times the correct value corresponds to shifting the decimal point one position in the numeral."
    },
    "prem_8dcebb1c4539b6ab": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_8dcebb1c4539b6ab",
      "premise_type": "empirical-citable",
      "termination_reason": null,
      "text": "Spinach's iron content is not distinctive among common leafy green vegetables, so its measured iron level alone would not single it out as an iron-rich food."
    },
    "prem_a6ab0925a1567bb3": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_a6ab0925a1567bb3",
      "premise_type": "empirical-citable",
      "termination_reason": null,
      "text": "Nineteenth-century published chemical analyses of spinach reported its iron content as approximately 35 mg per 100 g of fresh spinach."
    },
    "prem_b7b3c3a930372ec6": {
      "bound_key": null,
      "candidate_key": null,
      "evidence_state": "unverified",
      "evidence_state_provisional": true,
      "id": "prem_b7b3c3a930372ec6",
      "premise_type": "empirical-citable",
      "termination_reason": null,
      "text": "Modern food-composition tables give the iron content of raw spinach as approximately 3.5 mg per 100 g."
    },
    "prem_db3b182dd57d650a": {
      "bound_key": {
        "type": "doi",
        "value": "10.1136/bmj.283.6307.1671"
      },
      "candidate_key": {
