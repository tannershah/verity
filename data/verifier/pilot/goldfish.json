      "premise_type": "definitional",
      "termination_reason": null,
      "text": "Memory span is defined as the maximum time interval over which an animal can retain learned information such that it still influences the animal's behavior."
    },
    "prem_334dc1b154956e92": {
      "bound_key": null,
      "candidate_key": null,
