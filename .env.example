# Copy to .env and fill in. .env is gitignored — never commit keys.
ANTHROPIC_API_KEY=          # required — claim-side LLM calls (decomposition, normalization)
OPENALEX_API_KEY=           # required — https://openalex.org/settings/api (free; 100k credits/day; singleton GET=1 credit, filtered list=10)
NCBI_API_KEY=               # free — NCBI account > Account Settings > API Key Management (raises E-utilities 3 -> 10 req/s)
CROSSREF_MAILTO=            # any email you accept exposing in API request headers (Crossref polite pool)
SEMANTIC_SCHOLAR_API_KEY=   # optional — free tier is 1 req/s; test the unauthenticated pool too

# Operational knobs are overridable as VERITY_<SECTION>__<FIELD>, e.g.
#   VERITY_DECOMPOSITION__DEPTH_BUDGET=3
#   VERITY_RETRIEVAL__TOP_K=10
# Pre-registered evaluation thresholds are deliberately not configurable —
# they are constants in src/verity/thresholds.py.
